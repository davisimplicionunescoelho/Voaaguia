            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "strategyId": {
            "type": "string"
          },
          "authorId": {
            "type": "string"
          },
          "authorName": {
            "type": "string"
          },
          "department": {
            "type": "string"
