  "components": {
    "schemas": {
      "Strategy": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 0
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "campaign": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "campaign",
          "category",
          "description",
          "title"
        ]
      },
      "Guideline": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "campaign": {
            "type": "string"
          },
          "authorId": {
            "type": "string"
          },
          "authorName": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "ProjectInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 0
          },
          "ideaId": {
            "type": "string",
            "minLength": 1
          },
          "strategyId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "pattern": "PLANEJAMENTO|EM_ANDAMENTO|CONCLUIDO|CANCELADO"
          },
          "stage": {
            "type": "string",
            "minLength": 1,
            "pattern": "IDEACAO|VALIDACAO|DESENVOLVIMENTO|PILOTO|IMPLANTACAO|OPERACAO"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "expectedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "actualEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "investment": {
            "type": "number",
            "minimum": 0
          },
          "expectedReturn": {
            "type": "number",
            "minimum": 0
          },
          "actualReturn": {
            "type": "number",
            "minimum": 0
          },
          "costReduction": {
            "type": "number",
            "minimum": 0
          },
          "productivityGain": {
            "type": "number",
            "format": "double",
            "maximum": 100,
            "minimum": 0
          },
          "progressPercent": {
            "type": "integer",
            "format": "int32",
            "maximum": 100,
            "minimum": 0
          },
          "notes": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 0
          }
        },
        "required": [
          "actualReturn",
          "costReduction",
          "description",
          "expectedEndDate",
          "expectedReturn",
          "ideaId",
          "investment",
          "notes",
          "stage",
          "startDate",
          "status",
          "strategyId",
          "title"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ideaId": {
            "type": "string"
          },
          "strategyId": {
            "type": "string"
          },
          "managerId": {
            "type": "string"
          },
          "managerName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "expectedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "actualEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "investment": {
            "type": "number"
          },
          "expectedReturn": {
            "type": "number"
          },
          "actualReturn": {
            "type": "number"
          },
          "costReduction": {
            "type": "number"
          },
          "productivityGain": {
            "type": "number",
            "format": "double"
          },
          "progressPercent": {
            "type": "integer",
            "format": "int32"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "IdeaInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 0
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "strategyId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "category",
          "description",
          "strategyId",
          "title"
        ]
      },
      "Idea": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
